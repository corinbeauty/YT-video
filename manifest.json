{
  "manifest_version": 3,
  "name": "門店巡檢實體截圖系統",
  "version": "1.2",
  "description": "支援背景截圖與視窗自動放大縮小功能",
  "permissions": [
    "activeTab",
    "tabs",
    "windows" 
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
